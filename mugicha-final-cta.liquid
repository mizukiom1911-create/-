{% comment %}
  麦茶LP — 最終CTA
  紺背景・中央揃え・金のCTAボタン。ページ最下部の背中押し。
  クリックすると対象商品のバリアントをカートに追加してチェックアウトへ。
{% endcomment %}

{%- assign product = all_products[section.settings.product] -%}

<section class="final" data-final-cta>
  <div class="container final-inner">
    {%- if section.settings.eyebrow_en != blank -%}
      <span class="eyebrow-en">{{ section.settings.eyebrow_en }}</span>
    {%- endif -%}
    <h2>{{ section.settings.heading | replace: '|', '<br>' }}</h2>
    <hr class="line">
    {%- if section.settings.body != blank -%}
      <p>{{ section.settings.body | newline_to_br }}</p>
    {%- endif -%}

    {%- if product != blank -%}
      {%- assign v = product.selected_or_first_available_variant -%}
      <div class="final-price">
        <span class="price">{{ v.price | money }}</span>
        <span class="tax">税込 / {{ v.title }}</span>
      </div>
      <button type="button"
              class="cta"
              data-final-add
              data-variant-id="{{ v.id }}">
        {{ section.settings.cta_label | default: 'カートに入れる　→' }}
      </button>
    {%- else -%}
      <div style="color:var(--kane-400); font-family:var(--font-body); font-size:13px;">
        ⚠ 対象商品が設定されていません
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function() {
  const root = document.querySelector('[data-final-cta]');
  if (!root) return;
  const btn = root.querySelector('[data-final-add]');
  if (!btn) return;

  btn.addEventListener('click', async () => {
    const id = btn.getAttribute('data-variant-id');
    if (!id) return;
    try {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(id, 10), quantity: 1 }] })
      });
      window.location.href = '/checkout';
    } catch (e) {
      console.error(e);
      alert('カート追加に失敗しました。もう一度お試しください。');
    }
  });
})();
</script>

{% schema %}
{
  "name": "麦茶 最終CTA",
  "tag": "section",
  "class": "shopify-section-mugicha-final",
  "settings": [
    { "type": "product", "id": "product", "label": "対象商品" },
    { "type": "text", "id": "eyebrow_en", "label": "英字リード", "default": "Take This Home" },
    { "type": "text", "id": "heading", "label": "見出し（|で改行、<span class=\"kane\">〜</span>で金色）", "default": "いつもの一杯を、|<span class=\"kane\">明治十二年からの</span>一杯へ。" },
    { "type": "textarea", "id": "body", "label": "本文", "default": "コーヒーくらい黒いのに、飲むと苦くない。\n上野原の隣町から、手炒りの深みを、あなたの食卓へ。" },
    { "type": "text", "id": "cta_label", "label": "ボタン文言", "default": "カートに入れる　→" }
  ],
  "presets": [
    { "name": "麦茶 最終CTA" }
  ]
}
{% endschema %}
