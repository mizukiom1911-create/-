{% comment %}
  麦茶LP — 作り手ストーリー
  左：写真 / 右：作り手の物語 + 4つのファクト（Origin/Since/Rep/Craft）
{% endcomment %}

<section class="maker">
  <div class="container">
    <div class="maker-grid">
      <div class="maker-visual">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}"
               alt="{{ section.settings.image.alt | default: section.settings.heading }}">
        {%- endif -%}
      </div>
      <div class="maker-copy">
        {%- if section.settings.eyebrow_en != blank -%}
          <span class="eyebrow-en">{{ section.settings.eyebrow_en }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | replace: '|', '<br>' }}</h2>
        <hr class="line">
        {{ section.settings.body }}

        {%- if section.blocks.size > 0 -%}
          <div class="maker-facts">
            {%- for block in section.blocks -%}
              <div class="maker-fact">
                <div class="k">{{ block.settings.label_en }}</div>
                <div class="v">{{ block.settings.value | newline_to_br }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "麦茶 作り手",
  "tag": "section",
  "class": "shopify-section-mugicha-maker",
  "settings": [
    { "type": "text", "id": "eyebrow_en", "label": "英字リード", "default": "The Maker" },
    { "type": "text", "id": "heading", "label": "見出し（|で改行）", "default": "明治12年から、|三尺の平釜と、竹の箒で。" },
    { "type": "image_picker", "id": "image", "label": "写真（縦長 4:5 推奨）" },
    { "type": "richtext", "id": "body", "label": "本文（<span class=\"kane\">〜</span>で金色）", "default": "<p>上州屋設楽彦吉商店は、<span class=\"kane\">山梨県上野原市野田尻</span>にある、明治12年（1879年）創業の老舗です。ながおか商店と同じ上野原の隣町、車で15分の場所にあります。</p><p>製造する麦茶は、いまも直径三尺（約90cm）の平釜に大麦を入れ、竹の箒でかき混ぜながら強火で炒り上げる手仕事。麦が炭になる寸前まで深く炒ることで、この色と香りが出せます。</p><p>収穫年度や天候で変わる大麦の個性に合わせて、仕上げのタイミングや箒のスピードを変える。<span class=\"kane\">機械には出せない味</span>が、この釜のなかで生まれています。</p>" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "fact",
      "name": "ファクト",
      "settings": [
        { "type": "text", "id": "label_en", "label": "ラベル（英字）", "default": "Origin" },
        { "type": "text", "id": "value", "label": "値（改行OK）", "default": "山梨県\n上野原市野田尻" }
      ]
    }
  ],
  "presets": [
    {
      "name": "麦茶 作り手",
      "blocks": [
        { "type": "fact", "settings": { "label_en": "Origin", "value": "山梨県\n上野原市野田尻" } },
        { "type": "fact", "settings": { "label_en": "Since",  "value": "明治12年\n（1879）" } },
        { "type": "fact", "settings": { "label_en": "Rep",    "value": "設楽 徳子\n代表取締役" } },
        { "type": "fact", "settings": { "label_en": "Craft",  "value": "平釜3基\n手炒り製法" } }
      ]
    }
  ]
}
{% endschema %}
