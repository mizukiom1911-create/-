{% comment %}
  麦茶LP — Compare
  一般的なペットボトル麦茶 vs 手炒り麦茶 の左右2カラム比較。
{% endcomment %}

<section class="compare">
  <div class="container-narrow">
    <div class="sec-head" style="margin-bottom:40px;">
      {%- if section.settings.eyebrow_en != blank -%}
        <span class="eyebrow-en">{{ section.settings.eyebrow_en }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | replace: '|', '<br>' }}</h2>
      <hr class="line">
    </div>

    <div class="compare-inner">
      <div class="compare-col">
        <div class="compare-tag">{{ section.settings.left_tag }}</div>
        <div class="compare-name">{{ section.settings.left_name }}</div>
        <ul class="compare-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'left_item' -%}
              <li>{{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div class="compare-col hero">
        <div class="compare-tag">{{ section.settings.right_tag }}</div>
        <div class="compare-name">{{ section.settings.right_name }}</div>
        <ul class="compare-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'right_item' -%}
              <li>{{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "麦茶 比較",
  "tag": "section",
  "class": "shopify-section-mugicha-compare",
  "settings": [
    { "type": "text", "id": "eyebrow_en", "label": "英字リード", "default": "Comparison" },
    { "type": "text", "id": "heading", "label": "見出し（|で改行）", "default": "ペットボトルの麦茶と、|何が違うのか。" },
    { "type": "header", "content": "左カラム（比較対象）" },
    { "type": "text", "id": "left_tag", "label": "タグ", "default": "General" },
    { "type": "text", "id": "left_name", "label": "名前", "default": "一般的なペットボトル麦茶" },
    { "type": "header", "content": "右カラム（自社商品）" },
    { "type": "text", "id": "right_tag", "label": "タグ", "default": "This" },
    { "type": "text", "id": "right_name", "label": "名前", "default": "純手炒り むぎ茶（上州屋設楽彦吉商店）" }
  ],
  "blocks": [
    {
      "type": "left_item",
      "name": "左カラム項目",
      "settings": [{ "type": "text", "id": "text", "label": "文言", "default": "色は薄い茶色、透けて見える" }]
    },
    {
      "type": "right_item",
      "name": "右カラム項目",
      "settings": [{ "type": "text", "id": "text", "label": "文言", "default": "コーヒーのように黒く、グラスの向こうが見えない" }]
    }
  ],
  "presets": [
    {
      "name": "麦茶 比較",
      "blocks": [
        { "type": "left_item",  "settings": { "text": "色は薄い茶色、透けて見える" } },
        { "type": "left_item",  "settings": { "text": "のどごしは軽いが、香りは控えめ" } },
        { "type": "left_item",  "settings": { "text": "冷やして飲むための味の設計" } },
        { "type": "left_item",  "settings": { "text": "大量生産・機械焙煎・短時間抽出" } },
        { "type": "left_item",  "settings": { "text": "牛乳や砂糖を合わせても味が負ける" } },
        { "type": "right_item", "settings": { "text": "コーヒーのように黒く、グラスの向こうが見えない" } },
        { "type": "right_item", "settings": { "text": "鼻を通る香ばしさ、追いかけてくる澄んだ深み" } },
        { "type": "right_item", "settings": { "text": "煮出し・冷やし・ホット、通年で飲める" } },
        { "type": "right_item", "settings": { "text": "明治12年から、直径三尺の平釜と竹箒による手炒り" } },
        { "type": "right_item", "settings": { "text": "砂糖・牛乳と合わせても、しっかり主役の味" } }
      ]
    }
  ]
}
{% endschema %}
